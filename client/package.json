{
  "name": "pixel-campus-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "gen:assets": "node ../tools/gen-assets.mjs",
    "gen:map": "node ../tools/gen-map-full.mjs",
    "gen:buildings": "node ../tools/gen-buildings.mjs",
    "gen:trees": "node ../tools/gen-trees.mjs",
    "validate:map": "node ../tools/validate-map.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
